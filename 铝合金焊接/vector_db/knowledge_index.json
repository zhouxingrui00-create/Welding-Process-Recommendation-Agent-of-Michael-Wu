, -0.024260699053001704, 0.0, -0.024260699053001704, -0.024260699053001704, 0.024260699053001704, 0.0, 0.04852139810600341, 0.0, 0.0, -0.024260699053001704, 0.024260699053001704, 0.0, -0.09704279621200682, 0.024260699053001704, 0.04852139810600341, -0.04852139810600341, 0.0, 0.0, -0.024260699053001704, -0.024260699053001704, 0.04852139810600341, 0.0, -0.09704279621200682, 0.024260699053001704, 0.0, -0.024260699053001704, 0.0, -0.024260699053001704, -0.024260699053001704, 0.024260699053001704, 0.024260699053001704, -0.12130349526500853, -0.09704279621200682, -0.24260699053001705, 0.024260699053001704, 0.0, 0.07278209715900512, 0.07278209715900512, 0.024260699053001704, 0.04852139810600341, 0.0, -0.07278209715900512, 0.0, 0.024260699053001704, 0.0, 0.0, 0.09704279621200682, 0.0, -0.04852139810600341, -0.024260699053001704, 0.024260699053001704, 0.024260699053001704, 0.04852139810600341, 0.024260699053001704, 0.07278209715900512, 0.024260699053001704, 0.04852139810600341, -0.024260699053001704, 0.07278209715900512, 0.0, 0.024260699053001704, -0.04852139810600341, -0.024260699053001704, 0.024260699053001704, 0.0, -0.024260699053001704, 0.024260699053001704, 0.0, 0.024260699053001704, -0.024260699053001704, 0.0, 0.024260699053001704, -0.024260699053001704, 0.0, -0.04852139810600341, -0.09704279621200682, 0.04852139810600341]}, {"id": "02_TIG典型参数适用边界.md#p0-c1", "source": "02_TIG典型参数适用边界.md", "filename": "02_TIG典型参数适用边界.md", "page": null, "chunk": 1, "text": "---\ntitle: TIG厂商典型参数的适用边界\nsource: Miller Aluminum Welding Guide, p.19\nurl: https://www.millerwelds.com/-/media/miller-electric/files/pdf/resources/aluminum_welding_guide.pdf\n---\n\n# 不能跨条件套用\n\nMiller 的典型表是铝合金角焊缝起始参数，按名义板厚和焊接位置区分。种子数据库只转录了少量用于自动化测试的行，并保留原始英制单位说明。对接焊缝、不同散热条件、不同设备波形或超出厚度窗口时，系统不输出这些数值。\n\n表下注释特别提醒：过高温度或长时间预热会降低焊缝强度，热处理状态母材尤其敏感。表中焊道数量和填充材料消耗仅针对单侧焊接。因此，即使数据库命中厂商行，也只能作为试焊起点，不能直接成为 WPS。", "vector": [0.0, 0.07312724241271307, 0.036563621206356534, 0.0, 0.0, 0.0, -0.07312724241271307, 0.0, 0.0, 0.0, 0.0365